+/* CJIT external-callback adaptation. A Metal frame's autorelease pool must
+ * finish before UIKit/AppKit drains the enclosing callback's pool. LoadContent,
+ * readback and suppressed draws can leave a frame open without Present().
+ * Submit that work without requesting a drawable or presenting another frame.
+ */
+static int32_t METAL_INTERNAL_EndCallback(MetalRenderer *renderer)
+{
+	if (renderer->shouldClearColor || renderer->shouldClearDepth || renderer->shouldClearStencil)
+	{
+		METAL_INTERNAL_UpdateRenderPass(renderer);
+	}
+	if (!renderer->frameInProgress)
+	{
+		return 0;
+	}
+	METAL_INTERNAL_EndPass(renderer);
+	mtlCommitCommandBuffer(renderer->commandBuffer);
+	objc_retain(renderer->commandBuffer);
+	renderer->committedCommandBuffer = renderer->commandBuffer;
+	renderer->commandBuffer = NULL;
+	objc_autoreleasePoolPop(renderer->pool);
+	renderer->pool = NULL;
+	METAL_INTERNAL_ResetBuffers(renderer);
+	METAL_INTERNAL_ResetTextures(renderer);
+	MOJOSHADER_mtlEndFrame();
+	renderer->frameInProgress = 0;
+	return 1;
 }
 
