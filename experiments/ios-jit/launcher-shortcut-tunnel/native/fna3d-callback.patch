+/* Private CJIT bridge API; the upstream ABI and other drivers are unchanged.
+ * Return 1 for submitted work, 0 for an already closed frame, -1 for another
+ * backend. Call on the rendering thread before returning to the native loop.
+ */
+FNA3DAPI int32_t FNA3D_CJIT_EndCallback(FNA3D_Device *device)
+{
+	if (device == NULL || device->ResetBackbuffer != METAL_ResetBackbuffer)
